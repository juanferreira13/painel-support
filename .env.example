# ---------------------------------------------------------------------------
# painel-sinistro — variáveis para a CONEXÃO com o Google Sheets (etapa 2).
#
# NADA disto é necessário para o visual (etapa 1, atual): o site funciona
# estático com dados de demonstração. Estas variáveis só entram quando o grupo
# support validar o visual e formos ligar os dashboards às planilhas reais.
#
# Elas ficam em Settings > Environment Variables no projeto da Vercel — NUNCA
# no código nem no navegador (contêm dados de associados e a chave da conta de
# serviço). As funções em /api é que leem o Sheets do lado do servidor.
# ---------------------------------------------------------------------------

# Login para abrir o site (HTTP Basic Auth), como no painel-web.
VIEW_USER=support
VIEW_PASSWORD=troque-por-uma-senha-longa

# Conta de serviço do Google (o MESMO arquivo já usado pela ferramenta local,
# sistema\sinistro-grupo-support-*.json) colado inteiro, em uma linha só.
# Compartilhe cada planilha com o e-mail ...iam.gserviceaccount.com como Leitor.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com"}

# IDs das planilhas (o trecho entre /d/ e /edit dos links GOOGLE_* do
# sistema\configuracao.env). Ex.: docs.google.com/spreadsheets/d/<ESTE_ID>/edit
#
# FASE 1 usa só estas duas:
#   SHEET_SINISTRO    = GOOGLE_SINISTRO    (gerencial; o painel lê a aba "SIGA")
#   SHEET_REGULADORES = GOOGLE_REGULADORES (reguladores; aba "REGULADORES")
# As outras duas ficam para a Fase 2 (gravação do preenchimento).
SHEET_SINISTRO=
SHEET_REGULADORES=
SHEET_ANALISTAS=
SHEET_CONSULTORES=
